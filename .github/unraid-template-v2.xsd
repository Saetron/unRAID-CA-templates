<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="booleanString">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
      <xs:enumeration value=""/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="configType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Port"/>
      <xs:enumeration value="Path"/>
      <xs:enumeration value="Variable"/>
      <xs:enumeration value="Device"/>
      <xs:enumeration value="Label"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="displayType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="always"/>
      <xs:enumeration value="advanced"/>
      <xs:enumeration value="always-hide"/>
      <xs:enumeration value="advanced-hide"/>
      <xs:enumeration value="hidden"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="configElement">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="Name" type="xs:string" use="required"/>
        <xs:attribute name="Target" type="xs:string" use="required"/>
        <xs:attribute name="Default" type="xs:string" use="required"/>
        <xs:attribute name="Mode" type="xs:string" use="required"/>
        <xs:attribute name="Description" type="xs:string" use="required"/>
        <xs:attribute name="Type" type="configType" use="required"/>
        <xs:attribute name="Display" type="displayType" use="required"/>
        <xs:attribute name="Required" type="booleanString" use="required"/>
        <xs:attribute name="Mask" type="booleanString" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:element name="Container">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Name" type="xs:string"/>
        <xs:element name="Repository" type="xs:string"/>
        <xs:element name="Registry" type="xs:string"/>
        <xs:element name="Network" type="xs:string"/>
        <xs:element name="MyIP" type="xs:string"/>
        <xs:element name="Shell" type="xs:string"/>
        <xs:element name="Privileged" type="booleanString"/>
        <xs:element name="Support" type="xs:string"/>
        <xs:element name="Project" type="xs:string"/>
        <xs:element name="Overview" type="xs:string"/>
        <xs:element name="Description" type="xs:string"/>
        <xs:element name="Category" type="xs:string"/>
        <xs:element name="WebUI" type="xs:string"/>
        <xs:element name="TemplateURL" type="xs:string"/>
        <xs:element name="Icon" type="xs:string"/>
        <xs:element name="ExtraParams" type="xs:string"/>
        <xs:element name="PostArgs" type="xs:string"/>
        <xs:element name="CPUset" type="xs:string"/>
        <xs:element name="DateInstalled" type="xs:string"/>
        <xs:element name="DonateText" type="xs:string"/>
        <xs:element name="DonateLink" type="xs:string"/>
        <xs:element name="DonateImg" type="xs:string"/>
        <xs:element name="Requires" type="xs:string"/>
        <xs:element name="ReadMe" type="xs:string"/>
        <xs:element name="Changes" type="xs:string"/>
        <xs:element name="BindTime" type="booleanString"/>
        <xs:element name="Beta" type="booleanString"/>
        <xs:element name="Config" type="configElement"/>
      </xs:choice>
      <xs:attribute name="version" use="required" fixed="2"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
