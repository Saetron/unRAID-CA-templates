<?xml version="1.0"?>
<Container version="2">
  <Name>FilaMan</Name>
  <Repository>ghcr.io/fire-devils/filaman-system</Repository>
  <Registry>https://github.com/fire-devils/filaman-system/pkgs/container/filaman-system</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/197096-support-saetron-docker-templates/</Support>
  <Project>https://github.com/fire-devils/filaman-system</Project>
  <Overview>FilaMan is an open-source, self-hosted filament management system designed for 3D printing enthusiasts to track spools, weights, materials, colors, storage locations, and usage.&#13;&#13;Default Credentials:&#13;Email: admin@example.com&#13;Password: admin123</Overview>
  <Category>Tools:Utilities Other:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Saetron/unRAID-CA-templates/refs/heads/main/templates/filaman/filaman.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Saetron/unRAID-CA-templates/refs/heads/main/templates/filaman/filaman.png</Icon>
  <Config Name="Config" Target="/app/data" Default="/mnt/user/appdata/filaman" Mode="rw" Description="Core application data and SQLite database." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/filaman</Config>
  <Config Name="WebUI" Target="8000" Default="8000" Mode="tcp" Description="Web interface port." Type="Port" Display="always" Required="true" Mask="false">8000</Config>
  <Config Name="ADMIN_EMAIL" Target="ADMIN_EMAIL" Default="admin@example.com" Mode="" Description="Initial administrator email address." Type="Variable" Display="advanced" Required="false" Mask="false">admin@example.com</Config>
  <Config Name="ADMIN_PASSWORD" Target="ADMIN_PASSWORD" Default="admin123" Mode="" Description="Initial administrator password." Type="Variable" Display="advanced" Required="false" Mask="true">admin123</Config>
  <Config Name="SECRET_KEY" Target="SECRET_KEY" Default="change-me-in-production" Mode="" Description="Secret key for session security and cryptographic signing (e.g. openssl rand -hex 32)." Type="Variable" Display="advanced" Required="false" Mask="true">change-me-in-production</Config>
  <Config Name="CSRF_SECRET_KEY" Target="CSRF_SECRET_KEY" Default="change-me-in-production" Mode="" Description="Secret key for CSRF token protection (e.g. openssl rand -hex 32)." Type="Variable" Display="advanced" Required="false" Mask="true">change-me-in-production</Config>
</Container>
